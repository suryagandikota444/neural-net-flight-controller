<mujoco model="quadrotor_x">
  <!--
    X-frame quadrotor MJCF model for STM32 FC training.
    Matches real hardware: F450 frame, 1118g, 225mm arms, 8045 props, 1400KV.
    Motor layout (top-down view, front = +X):

          FL(0,CCW)   FR(1,CW)
              \       /
               [body]
              /       \
          RL(3,CW)    RR(2,CCW)
  -->

  <compiler angle="radian" coordinate="local"/>

  <option timestep="0.00025" integrator="RK4" gravity="0 0 -9.81">
    <flag warmstart="enable"/>
  </option>

  <default>
    <geom rgba="0.3 0.3 0.3 1" contype="1" conaffinity="1"/>
    <joint damping="0" armature="0"/>
    <motor ctrllimited="true" ctrlrange="0 1"/>
  </default>

  <asset>
    <!-- Textures & materials for a nice-looking scene -->
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0.9 0.9 1.0"
             width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.85 0.85 0.85"
             rgb2="0.7 0.7 0.7" width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="8 8" reflectance="0.1"/>
    <material name="body_mat" rgba="0.15 0.15 0.15 1" specular="0.4" shininess="0.6"/>
    <material name="arm_mat"  rgba="0.25 0.25 0.25 1" specular="0.3"/>
    <material name="prop_ccw" rgba="0.1 0.7 0.3 0.8" specular="0.5"/>
    <material name="prop_cw"  rgba="0.8 0.2 0.2 0.8" specular="0.5"/>
    <material name="led_front" rgba="1 1 1 1" emission="1"/>
    <material name="led_rear"  rgba="1 0 0 1" emission="1"/>
    <material name="motor_mat" rgba="0.5 0.5 0.5 1" specular="0.6" shininess="0.8"/>
    <material name="target_mat" rgba="0 1 0 0.15"/>
  </asset>

  <worldbody>
    <!-- Ground -->
    <geom name="floor" type="plane" size="10 10 0.01" material="grid_mat"
          contype="1" conaffinity="1"/>

    <!-- Hover target ghost (visual only) -->
    <body name="target" pos="0 0 1" mocap="true">
      <geom type="sphere" size="0.05" material="target_mat"
            contype="0" conaffinity="0"/>
      <!-- Cross-hair ring -->
      <geom type="cylinder" size="0.15 0.002" material="target_mat"
            contype="0" conaffinity="0"/>
    </body>

    <!-- ============ QUADROTOR (F450) ============ -->
    <body name="drone" pos="0 0 1">
      <freejoint name="root"/>

      <!-- Whole rigid aircraft: nominal TOTAL mass and inertia, including motors.
           Inertia remains an estimate awaiting physical calibration.
           Child motor/prop geoms are visual/contact geometry with zero mass. -->
      <inertial pos="0 0 0" mass="1.118"
                diaginertia="0.018 0.018 0.035"/>

      <!-- Central body plate (F450 PCB ~15cm across) -->
      <geom name="body_top" type="box" size="0.07 0.07 0.008"
            pos="0 0 0.008" material="body_mat" mass="0.0"/>
      <geom name="body_bot" type="box" size="0.07 0.07 0.004"
            pos="0 0 -0.004" material="body_mat" mass="0.0"/>

      <!-- Front-facing LED -->
      <geom name="led_f" type="box" size="0.005 0.025 0.003"
            pos="0.075 0 0.008" material="led_front"
            contype="0" conaffinity="0" mass="0.0"/>
      <!-- Rear LED -->
      <geom name="led_r" type="box" size="0.005 0.025 0.003"
            pos="-0.075 0 0.008" material="led_rear"
            contype="0" conaffinity="0" mass="0.0"/>

      <!-- ---- ARM: Front-Left (+X, +Y)  225mm @ 45° → (0.16, 0.16) ---- -->
      <geom name="arm_fl" type="capsule" fromto="0.03 0.03 0  0.15 0.15 0"
            size="0.008" material="arm_mat" mass="0.0"/>
      <body name="motor_fl" pos="0.16 0.16 0.01">
        <geom name="motor_fl_can" type="cylinder" size="0.014 0.012"
              material="motor_mat" mass="0.0"/>
        <geom name="prop_fl" type="cylinder" size="0.102 0.002"
              pos="0 0 0.014" material="prop_ccw"
              contype="0" conaffinity="0" mass="0.0"/>
        <!-- Thrust (body +Z) -->
        <site name="thrust_fl" pos="0 0 0.016" size="0.005"/>
      </body>

      <!-- ---- ARM: Front-Right (+X, -Y) ---- -->
      <geom name="arm_fr" type="capsule" fromto="0.03 -0.03 0  0.15 -0.15 0"
            size="0.008" material="arm_mat" mass="0.0"/>
      <body name="motor_fr" pos="0.16 -0.16 0.01">
        <geom name="motor_fr_can" type="cylinder" size="0.014 0.012"
              material="motor_mat" mass="0.0"/>
        <geom name="prop_fr" type="cylinder" size="0.102 0.002"
              pos="0 0 0.014" material="prop_cw"
              contype="0" conaffinity="0" mass="0.0"/>
        <site name="thrust_fr" pos="0 0 0.016" size="0.005"/>
      </body>

      <!-- ---- ARM: Rear-Right (-X, -Y) ---- -->
      <geom name="arm_rr" type="capsule" fromto="-0.03 -0.03 0  -0.15 -0.15 0"
            size="0.008" material="arm_mat" mass="0.0"/>
      <body name="motor_rr" pos="-0.16 -0.16 0.01">
        <geom name="motor_rr_can" type="cylinder" size="0.014 0.012"
              material="motor_mat" mass="0.0"/>
        <geom name="prop_rr" type="cylinder" size="0.102 0.002"
              pos="0 0 0.014" material="prop_ccw"
              contype="0" conaffinity="0" mass="0.0"/>
        <site name="thrust_rr" pos="0 0 0.016" size="0.005"/>
      </body>

      <!-- ---- ARM: Rear-Left (-X, +Y) ---- -->
      <geom name="arm_rl" type="capsule" fromto="-0.03 0.03 0  -0.15 0.15 0"
            size="0.008" material="arm_mat" mass="0.0"/>
      <body name="motor_rl" pos="-0.16 0.16 0.01">
        <geom name="motor_rl_can" type="cylinder" size="0.014 0.012"
              material="motor_mat" mass="0.0"/>
        <geom name="prop_rl" type="cylinder" size="0.102 0.002"
              pos="0 0 0.014" material="prop_cw"
              contype="0" conaffinity="0" mass="0.0"/>
        <site name="thrust_rl" pos="0 0 0.016" size="0.005"/>
      </body>

      <!-- IMU sensor site (centre of body) -->
      <site name="imu" pos="0 0 0" size="0.005"/>

      <!-- Accelerometer and gyro -->
      <site name="accel_site" pos="0 0 0" size="0.001"/>
      <site name="gyro_site"  pos="0 0 0" size="0.001"/>
    </body>
  </worldbody>

  <!-- Actuators: one per motor, normalised [0, 1] -->
  <actuator>
    <general name="motor_fl" site="thrust_fl" gear="0 0 1 0 0 0"
             ctrlrange="0 1" ctrllimited="true"/>
    <general name="motor_fr" site="thrust_fr" gear="0 0 1 0 0 0"
             ctrlrange="0 1" ctrllimited="true"/>
    <general name="motor_rr" site="thrust_rr" gear="0 0 1 0 0 0"
             ctrlrange="0 1" ctrllimited="true"/>
    <general name="motor_rl" site="thrust_rl" gear="0 0 1 0 0 0"
             ctrlrange="0 1" ctrllimited="true"/>
  </actuator>

  <sensor>
    <!-- Body-frame accelerometer and gyro (like MPU6000 / ICM42688) -->
    <accelerometer name="accel" site="accel_site" noise="0.05"/>
    <gyro          name="gyro"  site="gyro_site"  noise="0.01"/>

    <!-- Frame position + orientation for reward / logging -->
    <framepos  name="drone_pos" objtype="body" objname="drone"/>
    <framequat name="drone_quat" objtype="body" objname="drone"/>
    <framelinvel  name="drone_vel"    objtype="body" objname="drone"/>
    <frameangvel  name="drone_angvel" objtype="body" objname="drone"/>
  </sensor>

</mujoco>
